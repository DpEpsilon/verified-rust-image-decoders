    },
    {
      "edge": "complete -> accepted M4 error/shape + M5 Info/physical-content contracts -> committed image_complete",
      "meaning": "The bridge composes already checked observations into independently defined MS/MS16 values. It does not reopen inflation, filtering, colour conversion or compositor algorithms."
    },
    {
      "edge": "native success -> actual checked document_context + committed model colour/T13 lemmas",
      "meaning": "The real walk/decode discharges each bridge precondition. There is no allocation-success or model-success antecedent on a public entry."
    },
    {
      "edge": "prepare_image actual checked header -> header_request_bounds -> reserve_image",
      "meaning": "The bound proof is textually before the first reservation, applies to both eventual failures and successes, and uses named caps."
    },
    {
      "edge": "allocation_complete -> existing image_call + sealed log_tied/request-prefix contracts",
      "meaning": "The relation uses the actual returned failure and exact Raw/Output log. Prefix index observations establish the explicit site exclusion; no second or synthetic log is supplied."
    },
