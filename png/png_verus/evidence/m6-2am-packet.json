  "dependency_graph": [
    {
      "edge": "MFr/record -> mathematical MWF, default/frame data prefix, canonical fold",
      "meaning": "Definitions depend on input, checked mathematical document/control fields, P11/P13 source equations and canonical disposal/OVER. They do not call native decoders, inspect a history, invoke the certificate or choose an MK output."
    },
    {
      "edge": "canonical fold -> prepared prior model state + independent source pixels -> new pointwise draw",
      "meaning": "The displayed canvas and before-draw reference are computed recursively from model state alone. M5 geometry/control helpers read mathematical Doc fields, not native Trace/Saved state."
    },
    {
      "edge": "accepted MK -> mk_deterministic -> canonical draw equality",
      "meaning": "Existing M5 full-pixel observations and footprint determine every byte. This theorem points from the accepted relation to an already defined function; it does not define the function from the relation."
    },
    {
      "edge": "M5 trace wf + independent data prefix -> induction -> complete MFr prefix equality",
      "meaning": "For reused frame zero the native initial decoded buffer is not identified with logical transparent black; the accepted reuse equation supplies that bridge. Later references use the independently derived preceding before-draw canvas, not arbitrary Saved contents."
    },
    {
      "edge": "model_totality -> callers::frames + constructor_info + checked FrameState selection contracts",
      "meaning": "The certificate receives either an actual walk error or a checked document. It selects all structurally validated frame sources, even if earlier measured data fails, solely to exclude internal domain markers; it does not simulate or replace the shipping iterator."
    },
    {
      "edge": "model_totality -> measure_data -> raw_size + inflate_zlib_measure/status_eq contracts",
      "meaning": "One fixed WINDOW_MAX stack window is reused with actual source readers and exact frame limits. status_eq excludes OutsideDomain for every native status, including format errors and Full; no successful-inflate or allocation premise is assumed."
    },
    {
      "edge": "two defining-module proof bridges -> existing opaque source/job invariants",
      "meaning": "Only source_context and measure_context are added to frame_state.rs. They reveal existing invariant facts in their defining module; existing algorithms, contracts and public APIs are unchanged."
    },
    {
      "edge": "model_theorems -> checked totality certificate + pure metadata/source/resource lemmas",
      "meaning": "The theorem has no input or allocation-success precondition. Constructor and terminal domain markers are both excluded; keeping a terminal marker in the internal projection avoids requiring a future-frame shipping prepass in 2a-E."
    }
  ],
